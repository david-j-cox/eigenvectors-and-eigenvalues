\cf11 \strokec11 nb\cf10 \strokec2  \cf8 \strokec8 =\cf10 \strokec2  \cf11 \strokec11 nbf\cf8 \strokec8 .\cf10 \strokec2 v4\cf8 \strokec8 .\cf10 \strokec2 new_notebook()\
\cf11 \strokec11 cells\cf10 \strokec2  \cf8 \strokec8 =\cf10 \strokec2  []\
