\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
# Individual-Level Behavior Dynamics\
\
## Estimating, validating, and interpreting \\(A_i\\), \\(A_i+B_i u_t\\), and \\(A_\{i,c\}\\)\
\
This notebook treats the **individual organism as the primary unit of analysis**.\
\
\\[\
x_\{i,t+1\}=A_i x_\{i,t\}\
\\]\
\
\\[\
x_\{i,t+1\}=A_i x_\{i,t\}+B_i u_t+c_i\
\\]\
\
\\[\
x_\{i,t+1\}=A_\{i,c\}x_\{i,t\}\
\\]\
\
The analysis order is:\
\
1. Can a model trained on earlier behavior of one individual predict later behavior of that same individual?\
2. What are that individual's eigenvalues and eigenvectors?\
3. Are the individual's eigenvectors stable enough to interpret?\
4. Do similar dynamical modes recur across individuals?\
5. Only then do we summarize across participants.\
\
Cross-participant generalization is secondary.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
from pathlib import Path\
from itertools import combinations\
\
import numpy as np\
import pandas as pd\
import matplotlib.pyplot as plt\
\
from sklearn.preprocessing import StandardScaler\
from sklearn.linear_model import Ridge\
from sklearn.metrics import mean_squared_error, r2_score\
\
pd.set_option("display.max_columns", 100)\
pd.set_option("display.precision", 4)\
\
DATA_PATH = next(\
    (p for p in [Path("events.csv"), Path("/mnt/data/events.csv")] if p.exists()),\
    None\
)\
if DATA_PATH is None:\
    raise FileNotFoundError("Place events.csv beside this notebook.")\
\
raw = pd.read_csv(DATA_PATH).sort_values(\
    ["participant_id", "click_index"]\
).copy()\
\
print(f"Raw clicks: \{len(raw):,\}")\
print(f"Participants: \{raw['participant_id'].nunique()\}")\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
## 1. Reconstruct the behavioral state\
\
\\[\
x_t=\
\\begin\{bmatrix\}\
P(A)_t\\\\\
P(\\mathrm\{reward\})_t\\\\\
P(\\mathrm\{switch\})_t\\\\\
\\overline\{\\log(1+\\mathrm\{ICI\})\}_t\
\\end\{bmatrix\}.\
\\]\
\
Each state is a **non-overlapping 10-click bin within phase**.\
\
The eigenvector entries always correspond to:\
\
1. Choice allocation \\(P(A)\\)\
2. Obtained reward rate\
3. Switch rate\
4. Mean log inter-click interval\
\
States are standardized **within participant**.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
raw["choice_A_raw"] = (raw["chosen_option"] == "A").astype(int)\
\
raw["switch_raw"] = (\
    raw.groupby("participant_id")["chosen_option"]\
       .transform(lambda s: s.ne(s.shift()).astype(int))\
)\
raw.loc[\
    raw.groupby("participant_id").head(1).index,\
    "switch_raw"\
] = 0\
\
raw["log_ici_for_state"] = np.log1p(\
    raw["ici_s"].clip(lower=0, upper=5)\
)\
\
raw["click_within_phase"] = (\
    raw.groupby(["participant_id", "phase_id"]).cumcount()\
)\
\
BIN_CLICKS = 10\
raw["state_bin"] = raw["click_within_phase"] // BIN_CLICKS\
\
STATE_COLS = [\
    "choice_prop_A",\
    "reward_rate",\
    "switch_rate",\
    "mean_log_ici",\
]\
\
states = (\
    raw.groupby(\
        ["participant_id", "phase_id", "phase_label", "state_bin"],\
        as_index=False\
    )\
    .agg(\
        n_clicks=("click_index", "size"),\
        choice_prop_A=("choice_A_raw", "mean"),\
        reward_rate=("reward_outcome", "mean"),\
        switch_rate=("switch_raw", "mean"),\
        mean_log_ici=("log_ici_for_state", "mean"),\
        bonus_A=("bonus_target", lambda s: np.mean(s == "A")),\
        bonus_B=("bonus_target", lambda s: np.mean(s == "B")),\
    )\
)\
\
states = states.loc[states["n_clicks"] >= 5].copy()\
\
display(\
    states.groupby(["participant_id", "phase_id"])\
          .size()\
          .describe()\
          .to_frame("states_per_participant_phase")\
)\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
## 2. Construct within-phase transitions\
\
For context-specific eigenanalysis, transitions remain inside the same phase:\
\
\\[\
x_t\\rightarrow x_\{t+1\}.\
\\]\
\
Phase boundaries are excluded here and can be treated separately as perturbations.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
rows = []\
\
for (pid, phase), g in states.groupby(["participant_id", "phase_id"]):\
    g = g.sort_values("state_bin").reset_index(drop=True)\
\
    for j in range(len(g)-1):\
        if g.loc[j+1, "state_bin"] != g.loc[j, "state_bin"] + 1:\
            continue\
\
        row = \{\
            "participant_id": pid,\
            "phase_id": int(phase),\
            "phase_label": g.loc[j, "phase_label"],\
            "transition_order": j,\
            "bonus_A_next": g.loc[j+1, "bonus_A"],\
            "bonus_B_next": g.loc[j+1, "bonus_B"],\
        \}\
\
        for col in STATE_COLS:\
            row[f"\{col\}_t"] = g.loc[j, col]\
            row[f"\{col\}_next"] = g.loc[j+1, col]\
\
        rows.append(row)\
\
tr = pd.DataFrame(rows)\
\
print(f"Within-phase transitions: \{len(tr):,\}")\
display(\
    tr.groupby("participant_id")\
      .size()\
      .describe()\
      .to_frame("transitions_per_participant")\
)\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
# Part A \'97 Within-individual prediction\
\
## 3. Temporal holdout scheme\
\
For each participant \'d7 phase:\
\
- first 70% of transitions = training\
- last 30% = held-out test\
\
This evaluates whether earlier observations of one person predict **later behavior of that same person** while ensuring each experimental environment is represented in training.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
def temporal_masks_for_participant(g, train_fraction=0.70, min_phase_n=5):\
    train = pd.Series(False, index=g.index)\
    test = pd.Series(False, index=g.index)\
\
    for phase, gp in g.groupby("phase_id"):\
        gp = gp.sort_values("transition_order")\
        n = len(gp)\
\
        if n < min_phase_n:\
            continue\
\
        cut = max(2, int(np.floor(train_fraction * n)))\
        cut = min(cut, n-1)\
\
        train.loc[gp.index[:cut]] = True\
        test.loc[gp.index[cut:]] = True\
\
    return train, test\
\
outer_split_rows = []\
\
for pid, g in tr.groupby("participant_id"):\
    train_mask, test_mask = temporal_masks_for_participant(g)\
\
    outer_split_rows.append(\{\
        "participant_id": pid,\
        "n_train": int(train_mask.sum()),\
        "n_test": int(test_mask.sum()),\
        "phases_in_test": int(g.loc[test_mask, "phase_id"].nunique()),\
    \})\
\
split_summary = pd.DataFrame(outer_split_rows)\
display(split_summary.describe(numeric_only=True))\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
## 4. Regularization and nested tuning\
\
A \\(4\\times4\\) operator contains 16 state-transition coefficients, so individual phase-specific matrices can be unstable.\
\
Ridge regression is used:\
\
\\[\
\\hat C\
=\
\\arg\\min_C\\left\\\{\\|Y-XC\\|^2+\\alpha\\|C\\|^2\\right\\\}.\
\\]\
\
For each participant and architecture, \\(\\alpha\\) is selected using an **inner temporal validation split inside the outer training set**. The final held-out observations are never used to tune regularization.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
ALPHAS = [0.0, 0.01, 0.1, 1.0, 10.0]\
\
def make_inputs(df):\
    return np.column_stack([\
        (df["phase_id"].to_numpy() == 2).astype(float),\
        (df["phase_id"].to_numpy() == 3).astype(float),\
        (df["phase_id"].to_numpy() == 4).astype(float),\
        df["bonus_A_next"].to_numpy(float),\
        df["bonus_B_next"].to_numpy(float),\
    ])\
\
def inner_temporal_split(train_df, fraction=0.75):\
    inner_train = pd.Series(False, index=train_df.index)\
    inner_val = pd.Series(False, index=train_df.index)\
\
    for phase, gp in train_df.groupby("phase_id"):\
        gp = gp.sort_values("transition_order")\
        n = len(gp)\
\
        if n < 4:\
            inner_train.loc[gp.index] = True\
            continue\
\
        cut = max(2, int(np.floor(fraction*n)))\
        cut = min(cut, n-1)\
\
        inner_train.loc[gp.index[:cut]] = True\
        inner_val.loc[gp.index[cut:]] = True\
\
    return inner_train, inner_val\
\
def ridge_fit(X, Y, alpha):\
    model = Ridge(alpha=alpha, fit_intercept=True)\
    model.fit(X, Y)\
    return model\
\
def select_alpha(train_df, architecture):\
    # Uses only an inner temporal split of the participant's outer-training data.\
    inner_train_mask, inner_val_mask = inner_temporal_split(train_df)\
\
    inner_train = train_df.loc[inner_train_mask]\
    inner_val = train_df.loc[inner_val_mask]\
\
    if len(inner_val) == 0:\
        return 1.0\
\
    Xcols = [f"\{c\}_t" for c in STATE_COLS]\
    Ycols = [f"\{c\}_next" for c in STATE_COLS]\
\
    scaler = StandardScaler().fit(inner_train[Xcols])\
    Xtr = scaler.transform(inner_train[Xcols])\
    Ytr = scaler.transform(inner_train[Ycols])\
    Xva = scaler.transform(inner_val[Xcols])\
    Yva = scaler.transform(inner_val[Ycols])\
\
    scores = []\
\
    for alpha in ALPHAS:\
        if architecture == "pooled":\
            model = ridge_fit(Xtr, Ytr, alpha)\
            pred = model.predict(Xva)\
            scores.append((alpha, mean_squared_error(Yva, pred)))\
\
        elif architecture == "dmdc":\
            Dtr = np.column_stack([Xtr, make_inputs(inner_train)])\
            Dva = np.column_stack([Xva, make_inputs(inner_val)])\
            model = ridge_fit(Dtr, Ytr, alpha)\
            pred = model.predict(Dva)\
            scores.append((alpha, mean_squared_error(Yva, pred)))\
\
        elif architecture == "phase":\
            pred = np.full_like(Yva, np.nan)\
\
            for p in sorted(inner_val["phase_id"].unique()):\
                trp = inner_train["phase_id"].to_numpy() == p\
                vap = inner_val["phase_id"].to_numpy() == p\
\
                if trp.sum() < 3:\
                    continue\
\
                model = ridge_fit(Xtr[trp], Ytr[trp], alpha)\
                pred[vap] = model.predict(Xva[vap])\
\
            valid = np.isfinite(pred).all(axis=1)\
            if valid.sum() > 0:\
                scores.append(\
                    (alpha, mean_squared_error(Yva[valid], pred[valid]))\
                )\
        else:\
            raise ValueError(architecture)\
\
    if not scores:\
        return 1.0\
\
    return min(scores, key=lambda z: z[1])[0]\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
## 5. Evaluate every architecture separately for every participant\
\
Models:\
\
1. Persistence: \\(x_\{t+1\}=x_t\\)\
2. Individual \\(A_i\\)\
3. Individual DMDc: \\(A_i+B_i u_t\\)\
4. Individual context-specific \\(A_\{i,c\}\\)\
\
The key output is the **distribution across individuals**, not a single pooled score.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
Xcols = [f"\{c\}_t" for c in STATE_COLS]\
Ycols = [f"\{c\}_next" for c in STATE_COLS]\
\
prediction_rows = []\
feature_rows = []\
\
for pid, g in tr.groupby("participant_id"):\
    g = g.sort_values(["phase_id", "transition_order"]).copy()\
\
    train_mask, test_mask = temporal_masks_for_participant(g)\
    train_df = g.loc[train_mask].copy()\
    test_df = g.loc[test_mask].copy()\
\
    if len(train_df) < 15 or len(test_df) < 4:\
        continue\
\
    scaler = StandardScaler().fit(train_df[Xcols])\
    Xtr = scaler.transform(train_df[Xcols])\
    Ytr = scaler.transform(train_df[Ycols])\
    Xte = scaler.transform(test_df[Xcols])\
    Yte = scaler.transform(test_df[Ycols])\
\
    predictions = \{"Persistence": Xte.copy()\}\
    alphas = \{"Persistence": np.nan\}\
\
    a_pool = select_alpha(train_df, "pooled")\
    m_pool = ridge_fit(Xtr, Ytr, a_pool)\
    predictions["Individual A_i"] = m_pool.predict(Xte)\
    alphas["Individual A_i"] = a_pool\
\
    a_ctrl = select_alpha(train_df, "dmdc")\
    Dtr = np.column_stack([Xtr, make_inputs(train_df)])\
    Dte = np.column_stack([Xte, make_inputs(test_df)])\
    m_ctrl = ridge_fit(Dtr, Ytr, a_ctrl)\
    predictions["Individual DMDc"] = m_ctrl.predict(Dte)\
    alphas["Individual DMDc"] = a_ctrl\
\
    a_phase = select_alpha(train_df, "phase")\
    phase_pred = np.full_like(Yte, np.nan)\
\
    for p in sorted(test_df["phase_id"].unique()):\
        trp = train_df["phase_id"].to_numpy() == p\
        tep = test_df["phase_id"].to_numpy() == p\
\
        if trp.sum() < 4:\
            continue\
\
        mp = ridge_fit(Xtr[trp], Ytr[trp], a_phase)\
        phase_pred[tep] = mp.predict(Xte[tep])\
\
    predictions["Individual A_i,c"] = phase_pred\
    alphas["Individual A_i,c"] = a_phase\
\
    for model_name, pred in predictions.items():\
        valid = np.isfinite(pred).all(axis=1)\
\
        if valid.sum() < 3:\
            continue\
\
        y = Yte[valid]\
        phat = pred[valid]\
\
        prediction_rows.append(\{\
            "participant_id": pid,\
            "model": model_name,\
            "alpha": alphas[model_name],\
            "n_test": int(valid.sum()),\
            "MSE": mean_squared_error(y, phat),\
            "R2": r2_score(y, phat, multioutput="variance_weighted"),\
        \})\
\
        for j, feature in enumerate(STATE_COLS):\
            feature_rows.append(\{\
                "participant_id": pid,\
                "model": model_name,\
                "feature": feature,\
                "MSE": mean_squared_error(y[:,j], phat[:,j]),\
            \})\
\
predictions_individual = pd.DataFrame(prediction_rows)\
feature_performance = pd.DataFrame(feature_rows)\
\
summary = (\
    predictions_individual.groupby("model")\
    .agg(\
        participants=("participant_id", "nunique"),\
        median_R2=("R2", "median"),\
        mean_R2=("R2", "mean"),\
        q25_R2=("R2", lambda x: x.quantile(.25)),\
        q75_R2=("R2", lambda x: x.quantile(.75)),\
        median_MSE=("MSE", "median"),\
    )\
    .sort_values("median_R2", ascending=False)\
)\
\
display(summary)\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
fig, ax = plt.subplots(figsize=(9,5))\
models = summary.index.tolist()\
data = [\
    predictions_individual.loc[\
        predictions_individual["model"] == m, "R2"\
    ].dropna().to_numpy()\
    for m in models\
]\
\
ax.boxplot(data, tick_labels=models, showfliers=False)\
ax.axhline(0, linestyle="--", linewidth=1)\
ax.set_ylabel("Within-participant held-out R\'b2")\
ax.set_title("Predicting later behavior of the same individual")\
ax.tick_params(axis="x", rotation=25)\
plt.tight_layout()\
plt.show()\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
## 6. How many individuals benefit?\
\
Count how often each learned model beats persistence **for the same participant**.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
wide_r2 = predictions_individual.pivot(\
    index="participant_id",\
    columns="model",\
    values="R2"\
)\
\
improvement_rows = []\
\
if "Persistence" in wide_r2:\
    for model in [m for m in wide_r2.columns if m != "Persistence"]:\
        paired = wide_r2[[model, "Persistence"]].dropna()\
\
        improvement_rows.append(\{\
            "model": model,\
            "n_participants": len(paired),\
            "n_better_than_persistence": int(\
                (paired[model] > paired["Persistence"]).sum()\
            ),\
            "proportion_better": float(\
                (paired[model] > paired["Persistence"]).mean()\
            ),\
            "median_R2_improvement": float(\
                (paired[model] - paired["Persistence"]).median()\
            ),\
        \})\
\
display(pd.DataFrame(improvement_rows))\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
# Part B \'97 Individual eigensystems\
\
After validation, refit each person's operator using all available observations so the final eigensystem uses the maximum amount of that individual's data.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
## 7. Final controlled operator \\(A_i+B_i u_t\\)\
\
The eigenvalues are computed from \\(A_i\\) only. \\(B_i\\) represents environmental forcing and is not part of the eigendecomposition.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
individual_controlled = \{\}\
individual_controlled_rows = []\
\
for pid, g in tr.groupby("participant_id"):\
    g = g.sort_values(["phase_id", "transition_order"]).copy()\
\
    if len(g) < 20:\
        continue\
\
    alpha = select_alpha(g, "dmdc")\
\
    scaler = StandardScaler().fit(g[Xcols])\
    X = scaler.transform(g[Xcols])\
    Y = scaler.transform(g[Ycols])\
    U = make_inputs(g)\
\
    D = np.column_stack([X, U])\
    model = ridge_fit(D, Y, alpha)\
\
    A_i = model.coef_[:, :len(STATE_COLS)]\
    B_i = model.coef_[:, len(STATE_COLS):]\
\
    vals, vecs = np.linalg.eig(A_i)\
    order = np.argsort(np.abs(vals))[::-1]\
    vals = vals[order]\
    vecs = vecs[:, order]\
\
    individual_controlled[pid] = \{\
        "A": A_i,\
        "B": B_i,\
        "eigenvalues": vals,\
        "eigenvectors": vecs,\
        "alpha": alpha,\
    \}\
\
    individual_controlled_rows.append(\{\
        "participant_id": pid,\
        "alpha": alpha,\
        "spectral_radius": float(np.max(np.abs(vals))),\
        "dominant_eigenvalue": vals[0],\
    \})\
\
individual_controlled_summary = pd.DataFrame(individual_controlled_rows)\
display(individual_controlled_summary.head())\
display(individual_controlled_summary["spectral_radius"].describe())\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
## 8. Fit \\(A_\{i,c\}\\): one operator for each individual \'d7 phase\
\
For each phase-specific operator, save its dominant eigenvalue, spectral radius, eigenvector loadings, and which state feature has the largest absolute loading.\
\
All phases for a given individual are expressed in that **same individual's standardized coordinate system**, so within-person phase comparisons are meaningful.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
individual_phase = \{\}\
phase_mode_rows = []\
\
for pid, gpid in tr.groupby("participant_id"):\
    alpha = select_alpha(gpid, "phase")\
\
    scaler = StandardScaler().fit(gpid[Xcols])\
    Xpid = scaler.transform(gpid[Xcols])\
    Ypid = scaler.transform(gpid[Ycols])\
\
    gpid = gpid.copy()\
    for j in range(len(STATE_COLS)):\
        gpid[f"Xz_\{j\}"] = Xpid[:,j]\
        gpid[f"Yz_\{j\}"] = Ypid[:,j]\
\
    for phase, gp in gpid.groupby("phase_id"):\
        if len(gp) < 8:\
            continue\
\
        Xp = gp[[f"Xz_\{j\}" for j in range(len(STATE_COLS))]].to_numpy()\
        Yp = gp[[f"Yz_\{j\}" for j in range(len(STATE_COLS))]].to_numpy()\
\
        model = ridge_fit(Xp, Yp, alpha)\
        A_ic = model.coef_\
\
        vals, vecs = np.linalg.eig(A_ic)\
        order = np.argsort(np.abs(vals))[::-1]\
        vals = vals[order]\
        vecs = vecs[:,order]\
\
        v = vecs[:,0]\
        genuinely_complex = np.max(np.abs(np.imag(v))) > 1e-8\
\
        if not genuinely_complex:\
            v = np.real(v).astype(float)\
            if v[np.argmax(np.abs(v))] < 0:\
                v = -v\
            v = v / np.linalg.norm(v)\
        else:\
            v = v / np.linalg.norm(v)\
\
        dominant_feature = STATE_COLS[int(np.argmax(np.abs(v)))]\
\
        individual_phase[(pid, int(phase))] = \{\
            "A": A_ic,\
            "eigenvalues": vals,\
            "eigenvectors": vecs,\
            "dominant_vector": v,\
            "alpha": alpha,\
            "n": len(gp),\
        \}\
\
        row = \{\
            "participant_id": pid,\
            "phase_id": int(phase),\
            "phase_label": gp["phase_label"].iloc[0],\
            "n_transitions": len(gp),\
            "alpha": alpha,\
            "spectral_radius": float(np.max(np.abs(vals))),\
            "dominant_eigenvalue": vals[0],\
            "dominant_feature": dominant_feature,\
            "dominant_is_complex": genuinely_complex,\
        \}\
\
        for feature, loading in zip(STATE_COLS, v):\
            row[f"loading_\{feature\}"] = loading\
\
        phase_mode_rows.append(row)\
\
phase_modes = pd.DataFrame(phase_mode_rows)\
\
print(f"Individual \'d7 phase operators estimated: \{len(phase_modes)\}")\
display(phase_modes.head())\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
## 9. Do individuals actually show the same dominant feature?\
\
This directly checks whether a pooled eigenvector describes a recurring individual-level phenomenon or an aggregate that no single participant reliably exhibits.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
dominant_counts = (\
    phase_modes.groupby(["phase_label", "dominant_feature"])\
    .size()\
    .rename("n")\
    .reset_index()\
)\
\
dominant_counts["proportion_within_phase"] = (\
    dominant_counts["n"]\
    / dominant_counts.groupby("phase_label")["n"].transform("sum")\
)\
\
display(\
    dominant_counts.sort_values(\
        ["phase_label", "proportion_within_phase"],\
        ascending=[True, False]\
    )\
)\
\
dominant_table = dominant_counts.pivot(\
    index="dominant_feature",\
    columns="phase_label",\
    values="proportion_within_phase"\
).fillna(0)\
\
fig, ax = plt.subplots(figsize=(10,5))\
dominant_table.T.plot(kind="bar", ax=ax)\
ax.set_ylabel("Proportion of individuals")\
ax.set_title("Feature dominating each individual's slowest mode")\
ax.tick_params(axis="x", rotation=25)\
plt.tight_layout()\
plt.show()\
'''\cf10 \strokec2 )\
\
\cf11 \strokec11 md\cf10 \strokec2 (\cf12 \strokec12 r"""\
# Part C \'97 Stability of each person's eigenvector\
\
## 10. Moving-block bootstrap\
\
An individual eigenvector is only interpretable if it is reasonably stable under resampling of that individual's own time series.\
\
Use contiguous blocks of four transitions, resampled with replacement. For every bootstrap sample, refit \\(A_\{i,c\}\\) and compare its dominant vector with the original using absolute cosine similarity:\
\
\\[\
S(v,\\hat v_b)\
=\
\\frac\{|v^\\ast \\hat v_b|\}\
\{\\|v\\|\\|\\hat v_b\\|\}.\
\\]\
\
\\(S=1\\) means the same eigendirection; \\(S=0\\) means orthogonal directions.\
"""\cf10 \strokec2 )\
\
\cf11 \strokec11 code\cf10 \strokec2 (\cf12 \strokec12 r'''\
RNG = np.random.default_rng(20260906)\
N_BOOT = 100\
BLOCK_LENGTH = 4\
\
def moving_block_indices(n, block_length, rng):\
    if n <= block_length:\
        return np.arange(n)\
\
    starts = np.arange(0, n - block_length + 1)\
    out = []\
\
    while len(out) < n:\
        start = int(rng.choice(starts))\
        out.extend(range(start, start + block_length))\
\
    return np.asarray(out[:n], dtype=int)\
\
bootstrap_rows = []\
\
for pid, gpid in tr.groupby("participant_id"):\
    scaler = StandardScaler().fit(gpid[Xcols])\
    Xpid = scaler.transform(gpid[Xcols])\
    Ypid = scaler.transform(gpid[Ycols])\
\
    gpid = gpid.copy()\
    for j in range(len(STATE_COLS)):\
        gpid[f"Xz_\{j\}"] = Xpid[:,j]\
        gpid[f"Yz_\{j\}"] = Ypid[:,j]\
\
    alpha = select_alpha(gpid, "phase")\
\
    for phase, gp in gpid.groupby("phase_id"):\
        key = (pid, int(phase))\
        if key not in individual_phase:\
            continue\
\
        gp = gp.sort_values("transition_order")\
        Xp = gp[[f"Xz_\{j\}" for j in range(len(STATE_COLS))]].to_numpy()\
        Yp = gp[[f"Yz_\{j\}" for j in range(len(STATE_COLS))]].to_numpy()\
\
        original_v = np.asarray(\
            individual_phase[key]["dominant_vector"],\
            dtype=complex\
        )\
\
        for b in range(N_BOOT):\
            idx = moving_block_indices(len(gp), BLOCK_LENGTH, RNG)\
\
            model = ridge_fit(Xp[idx], Yp[idx], alpha)\
            Aboot = model.coef_\
\
            vals, vecs = np.linalg.eig(Aboot)\
            order = np.argsort(np.abs(vals))[::-1]\
            vals = vals[order]\
            vecs = vecs[:,order]\
\
            vb = vecs[:,0].astype(complex)\
\
            cosine = (\
                np.abs(np.vdot(original_v, vb))\
                / (np.linalg.norm(original_v) * np.linalg.norm(vb))\
            )\
\
            bootstrap_rows.append(\{\
                "participant_id": pid,\
                "phase_id": int(phase),\
                "phase_label": gp["phase_label"].iloc[0],\
                "bootstrap": b,\
                "eigenvector_cosine": float(np.real(cosine)),\
                "spectral_radius": float(np.max(np.abs(vals))),\
            \})\
\
bootstrap_modes = pd.DataFrame(bootstrap_rows)\
\
bootstrap_stability = (\
    bootstrap_modes.groupby(["participant_id", "phase_id", "phase_label"])\
    .agg(\
