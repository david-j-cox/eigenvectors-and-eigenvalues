RNG = np.random.default_rng(20260906)\
N_BOOT = 100\
BLOCK_LENGTH = 4\
\
def moving_block_indices(n, block_length, rng):\
    if n <= block_length:\
        return np.arange(n)\
\
    starts = np.arange(0, n - block_length + 1)\
    out = []\
\
    while len(out) < n:\
        start = int(rng.choice(starts))\
        out.extend(range(start, start + block_length))\
\
    return np.asarray(out[:n], dtype=int)\
\
bootstrap_rows = []\
\
# Recreate standardized participant coordinate systems\
for pid, gpid in tr.groupby("participant_id"):\
    scaler = StandardScaler().fit(gpid[Xcols])\
    Xpid = scaler.transform(gpid[Xcols])\
    Ypid = scaler.transform(gpid[Ycols])\
\
    gpid = gpid.copy()\
    for j in range(len(STATE_COLS)):\
        gpid[f"Xz_\{j\}"] = Xpid[:,j]\
        gpid[f"Yz_\{j\}"] = Ypid[:,j]\
\
    alpha = select_alpha(gpid, "phase")\
\
    for phase, gp in gpid.groupby("phase_id"):\
        key = (pid, int(phase))\
        if key not in individual_phase:\
            continue\
\
        gp = gp.sort_values("transition_order")\
        Xp = gp[[f"Xz_\{j\}" for j in range(len(STATE_COLS))]].to_numpy()\
        Yp = gp[[f"Yz_\{j\}" for j in range(len(STATE_COLS))]].to_numpy()\
\
        original_v = individual_phase[key]["dominant_vector"]\
        original_v = np.asarray(original_v, dtype=complex)\
\
        for b in range(N_BOOT):\
            idx = moving_block_indices(len(gp), BLOCK_LENGTH, RNG)\
\
            model = ridge_fit(Xp[idx], Yp[idx], alpha)\
            Aboot = model.coef_\
\
            vals, vecs = np.linalg.eig(Aboot)\
            order = np.argsort(np.abs(vals))[::-1]\
            vals = vals[order]\
            vecs = vecs[:,order]\
\
            vb = vecs[:,0].astype(complex)\
\
            cosine = (\
                np.abs(np.vdot(original_v, vb))\
                / (np.linalg.norm(original_v) * np.linalg.norm(vb))\
