\cf12 \strokec12 '''def fast_ridge_A(X, Y, alpha):\
    # Ridge with an unpenalized intercept. Centering removes the intercept,\
    # then solve directly; much faster than repeatedly constructing sklearn\
    # estimators inside the bootstrap.\
    Xc = X - X.mean(axis=0, keepdims=True)\
    Yc = Y - Y.mean(axis=0, keepdims=True)\
    penalty = alpha * np.eye(X.shape[1])\
    C = np.linalg.pinv(Xc.T @ Xc + penalty) @ Xc.T @ Yc\
    return C.T\
