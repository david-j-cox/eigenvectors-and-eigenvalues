# Copy to .env.local for local development. In production these are set in the
# Vercel project under Settings -> Environment Variables.
#
# All three are read by Vite AT BUILD TIME and inlined into the bundle. Changing
# one in Vercel therefore requires a redeploy; restarting is not enough.
#
# `npm run build:prod` refuses to build if any is missing or wrong, so the
# failure lands on you rather than on a participant.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# The ANON / publishable key -- never the service_role or sb_secret_ key.
# This value is published in the page bundle and readable by every participant.
# Row-level security limits it to inserts and updates; a privileged key would
# bypass RLS and expose every participant's data. Preflight blocks that.
VITE_SUPABASE_ANON_KEY=

# The completion code from the Prolific study, shown on the end screen.
# Prolific: Study -> Completion -> the code participants enter to be paid.
VITE_COMPLETION_CODE=
